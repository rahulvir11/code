"use client";
import { Stage, Layer, Image as KonvaImage, Rect } from "react-konva";
import React, { useRef, useEffect, useState } from "react";
import { animateSprite, applyPhysics, handleKeyDown, handleKeyUp, getImageFrame, checkCollision } from "@/helpers/game";
import { GameConfig, Platform, Player } from "@/interface";
import useImage from "use-image";

const CanvasStage = () => {
    const containerRef = useRef<HTMLDivElement>(null);
    const [dimensions, setDimensions] = useState({ width: 0, height: 0 });
    const [playerImage] = useImage('/player.png');

    const gameRef = useRef<GameConfig>({
        canvasWidth: 0,
        canvasHeight: 0,
        timer: 0,
        gravity: 0.8,
        scrollSpeed: 2,
        currentPlatformIndex: 0,
        fps: 60,
        interval: 1000 / 60,
        distanceBetweenPlatforms: 120,
        scrollThreshold: 0.6, // When player reaches 60% of screen height, scroll down
    });
    // Initialize player with proper values
    const playerRef = useRef<Player>({
        x: 0,
        y: 0,
        imageWidth: 60,
        imageHeight: 60,
        velocityX: 0,
        velocityY: 0,
        onGround: false,
        direction: "idle",
        frameY: 0,
        frameX: 0,
        spriteWidth: 250,
        spriteHeight: 280,
        jumpPower: -15,
        moveSpeed: 5,
        frameTimer: 0,
        animationSpeed: 8,
    });
    const platformsRef = useRef<Array<Platform>>([]);
    const [player, setPlayer] = useState<Player>(playerRef.current);
    const [platforms, setPlatforms] = useState<Array<Platform>>([]);



    // 🔹 Initialize platforms
    const initializePlatforms = (width: number, height: number) => {
        const platformHeight = 20;
        const platformColumns = 4;
        const tileWidth = width / platformColumns;
        const numberOfPlatforms = 10; // Fixed number of platforms

        const newPlatforms: Platform[] = [];

        for (let i = 0; i < numberOfPlatforms; i++) {
            for (let c = 0; c < platformColumns; c++) {
                const moves = Math.random() < 0.3; // 30% chance this tile moves

                newPlatforms.push({
                    id: `${i}-${c}`,
                    column: c,
                    x: c * tileWidth,
                    y: height - (i * gameRef.current.distanceBetweenPlatforms),
                    width: tileWidth,
                    height: platformHeight,
                    moves,
                    speedX: moves ? (Math.random() * 1 + 0.5) : 0,
                    direction: 1,
                    maxLeft: 0,
                    maxRight: width - tileWidth
                });
            }
        }

        platformsRef.current = newPlatforms;
        setPlatforms([...newPlatforms]);
    };

    // 🔹 Scroll platforms when player reaches center
    const scrollPlatforms = (scrollAmount: number) => {
        platformsRef.current = platformsRef.current.map(platform => ({
            ...platform,
            y: platform.y + scrollAmount
        }));

        setPlatforms([...platformsRef.current]);
    };

    // 🔹 Replace platforms that have gone off screen
    const replaceOffscreenPlatforms = (width: number, height: number) => {
        const platformColumns = 4;
        const tileWidth = width / platformColumns;
        let needsUpdate = false;

        // Find the highest platform (lowest y value)
        let highestPlatformY = height;
        platformsRef.current.forEach(platform => {
            if (platform.y < highestPlatformY) {
                highestPlatformY = platform.y;
            }
        });

        // Replace platforms that are below the screen
        platformsRef.current = platformsRef.current.map(platform => {
            if (platform.y > height) {
                needsUpdate = true;
                const moves = Math.random() < 0.3;

                // Place new platform above the highest existing platform
                return {
                    ...platform,
                    y: highestPlatformY - gameRef.current.distanceBetweenPlatforms,
                    x: platform.column * tileWidth,
                    moves,
                    speedX: moves ? (Math.random() * 1 + 0.5) : 0,
                    direction: 1
                };
            }
            return platform;
        });

        if (needsUpdate) {
            setPlatforms([...platformsRef.current]);
        }
    };

    // 🔹 Measure container size
    useEffect(() => {
        const updateSize = () => {
            if (containerRef.current) {
                const { clientWidth, clientHeight } = containerRef.current;
                setDimensions({ width: clientWidth, height: clientHeight });
                gameRef.current.canvasWidth = clientWidth;
                gameRef.current.canvasHeight = clientHeight;

                // Set player initial position after dimensions are known
                playerRef.current.x = clientWidth / 2 - playerRef.current.imageWidth / 2;
                playerRef.current.y = clientHeight - 200; // Start above bottom
                setPlayer({ ...playerRef.current });

                // Initialize platforms
                initializePlatforms(clientWidth, clientHeight);
            }
        };

        updateSize();
        window.addEventListener('resize', updateSize);
        return () => window.removeEventListener('resize', updateSize);
    }, []);

    // 🔹 Setup input handlers
    useEffect(() => {
        const handleKeyDownWrapper = (e: KeyboardEvent) => handleKeyDown(e, playerRef.current);
        const handleKeyUpWrapper = (e: KeyboardEvent) => handleKeyUp(e, playerRef.current);

        window.addEventListener("keydown", handleKeyDownWrapper);
        window.addEventListener("keyup", handleKeyUpWrapper);

        return () => {
            window.removeEventListener("keydown", handleKeyDownWrapper);
            window.removeEventListener("keyup", handleKeyUpWrapper);
        };
    }, []);

    // 🔹 Animation loop with FPS control
    useEffect(() => {
        if (dimensions.width === 0 || dimensions.height === 0) return;

        let animationFrame: number;
        let lastTime = 0;

        const loop = (timeStamp: number) => {
            if (!lastTime) lastTime = timeStamp;
            const deltaTime = timeStamp - lastTime;
            lastTime = timeStamp;

            gameRef.current.timer += deltaTime;

            // Apply physics and update player
            applyPhysics(gameRef.current, playerRef.current, dimensions, platformsRef.current);

            // Check for scrolling
            const scrollThreshold = dimensions.height * gameRef.current.scrollThreshold;
            if (playerRef.current.y < scrollThreshold) {
                const scrollAmount = scrollThreshold - playerRef.current.y;
                scrollPlatforms(scrollAmount);
                playerRef.current.y = scrollThreshold; // Keep player at threshold
            }

            // Replace off-screen platforms
            replaceOffscreenPlatforms(dimensions.width, dimensions.height);

            // Animate player sprite
            if (playerRef.current.frameTimer >= playerRef.current.animationSpeed) {
                animateSprite(playerRef.current);
                playerRef.current.frameTimer = 0;
            } else {
                playerRef.current.frameTimer += 1;
            }

            // Update moving platforms
            platformsRef.current.forEach(tile => {
                if (!tile.moves) return;

                tile.x += tile.speedX! * tile.direction!;

                // Reverse direction at bounds
                if (tile.x <= tile.maxLeft || tile.x + tile.width >= tile.maxRight) {
                    tile.direction! *= -1;
                }
            });

            // Update state to trigger re-render
            setPlayer({ ...playerRef.current });
            setPlatforms([...platformsRef.current]);

            animationFrame = requestAnimationFrame(loop);
        };

        animationFrame = requestAnimationFrame(loop);
        return () => cancelAnimationFrame(animationFrame);
    }, [dimensions.width, dimensions.height]);

    const renderPlayer = () => {
        if (!playerImage) return null;

        const columns = 4;
        const index = player.frameX + player.frameY * columns;
        const crop = getImageFrame(index, player.spriteWidth, player.spriteHeight, columns);

        return (
            <KonvaImage
                image={playerImage}
                x={player.x}
                y={player.y}
                width={player.imageWidth}
                height={player.imageHeight}
                crop={crop}
            />
        );
    };

    const renderPlatforms = () => {
        return platforms.map(platform => (
            <Rect
                key={platform.id}
                x={platform.x}
                y={platform.y}
                width={platform.width}
                height={platform.height}
                fill={platform.moves ? "#e74c3c" : "#3498db"} // Red for moving, blue for static
                stroke="#2c3e50"
                strokeWidth={2}
            />
        ));
    };

    return (
        <div ref={containerRef} className="w-1/2 h-screen bg-white/20 flex items-center justify-center">
            {dimensions.width > 0 && dimensions.height > 0 && (
                <Stage width={dimensions.width} height={dimensions.height}>
                    <Layer>
                        {/* Render platforms first so player appears on top */}
                        {renderPlatforms()}
                        {/* Render player */}
                        {renderPlayer()}
                    </Layer>
                </Stage>
            )}
        </div>
    );
};

export default CanvasStage;


import { GameConfig, Platform, Player } from "@/interface";

export const applyPhysics = (config: GameConfig, player: Player, dimensions: { width: number; height: number }, platforms: Platform[]) => {
  // Horizontal movement with boundaries
  player.x += player.velocityX;
  
  // Keep player within canvas bounds horizontally
  if (player.x < 0) {
    player.x = 0;
  } else if (player.x + player.imageWidth > dimensions.width) {
    player.x = dimensions.width - player.imageWidth;
  }

  // Apply gravity
  player.velocityY += config.gravity;
  player.y += player.velocityY;

  // Check collision with platforms
  checkCollision(player, platforms);

  // Ground collision (falling off the world)
  const groundLevel = dimensions.height;
  if (player.y >= groundLevel - player.imageHeight) {
    player.y = groundLevel - player.imageHeight;
    player.velocityY = 0;
    player.onGround = true;
  }
};

export const checkCollision = (player: Player, platforms: Platform[]) => {
  player.onGround = false;

  for (const p of platforms) {
    const touching =
      player.x < p.x + p.width &&
      player.x + player.imageWidth > p.x &&
      player.y + player.imageHeight >= p.y &&
      player.y + player.imageHeight <= p.y + p.height + 8 &&
      player.velocityY > 0;

    if (touching) {
      player.y = p.y - player.imageHeight;
      player.velocityY = 0;
      player.onGround = true;

      // ✅ Player moves with platform if platform moves
      if (p.moves) {
        player.x += p.speedX! * p.direction!;
      }

      break;
    }
  }
};

export const animateSprite = (player: Player) => {
  const framesPerRow = 4;

  // Update animation based on movement and direction
  if (player.velocityX !== 0) {
    // Walking animation - only update frameX if moving
    player.frameX = (player.frameX + 1) % framesPerRow;
  } else {
    // Idle animation - reset to first frame
    player.frameX = 0;
  }

  // Set frameY based on direction (already set in key handlers)
  // This ensures the correct animation row is maintained
};

export const handleKeyDown = (e: KeyboardEvent, player: Player) => {
  switch (e.key) {
    case "ArrowLeft":
      player.velocityX = -player.moveSpeed;
      player.direction = "left";
      player.frameY = 2; // Set to walking animation row for left
      break;
    case "ArrowRight":
      player.velocityX = player.moveSpeed;
      player.direction = "right";
      player.frameY = 1; // Set to walking animation row for right
      break;
    case "ArrowUp":
    case " ":
      if (player.onGround) {
        player.velocityY = player.jumpPower;
        player.onGround = false;
        // Optional: Add jump animation frame if you have one
        // player.frameY = 3; // Jump animation row
      }
      break;
  }
};

export const handleKeyUp = (e: KeyboardEvent, player: Player) => {
  switch (e.key) {
    case "ArrowLeft":
      player.velocityX = 0;
      player.direction = "idle";
      player.frameY = 0; // Set to idle animation
      player.frameX = 0; // Reset to first idle frame
      break;
    case "ArrowRight":
      player.velocityX = 0;
      player.direction = "idle";
      player.frameY = 0; // Set to idle animation
      player.frameX = 0; // Reset to first idle frame
      break;
  }
};

export const getImageFrame = (index: number, frameWidth: number, frameHeight: number, columns: number) => {
  const col = index % columns;
  const row = Math.floor(index / columns);

  return {
    x: col * frameWidth,
    y: row * frameHeight,
    width: frameWidth,
    height: frameHeight,
  };
};

export interface GameConfig {
  canvasWidth: number;
  canvasHeight: number;
  timer: number;
  gravity: number;
  scrollSpeed: number;
  currentPlatformIndex: number;
  interval: number;
  fps?: number;
  distanceBetweenPlatforms: number;
  scrollThreshold: number;
}

export interface Player {
  x: number;
  y: number;
  imageWidth: number;
  imageHeight: number;
  velocityX: number;
  velocityY: number;
  onGround: boolean;
  direction: "left" | "right" | "idle" | "jump";
  frameY: number;
  frameX: number;
  spriteWidth: number;
  spriteHeight: number;
  jumpPower: number;
  moveSpeed: number;
  frameTimer: number;
  animationSpeed: number;
}

export interface Platform {
  id: string;
  x: number;
  y: number;
  width: number;
  height: number;

  // New:
  column: number;       // index in multi-column platform
  moves: boolean;
  speedX: number;
  direction: number;    // 1 = right, -1 = left
  maxLeft: number;      // movement bounds
  maxRight: number;
}

