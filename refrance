// Get smooth progress percentage for power-up effects (for UI display)
  getPowerUpProgress(effectType) {
    const objects = this.gameObjects.current;
    const effect = objects.effects[effectType];
    
    if (!effect || !effect.active) {
      return 0;
    }
    
    // If restarting, return smooth restart progress
    if (effect.isRestarting && effect.restartProgress !== null) {
      // During restart, animate from current progress to 0, then to full
      const currentProgress = effect.duration / (effect.maxDuration || 1);
      const restartProgress = effect.restartProgress;
      
      if (restartProgress < 0.5) {
        // First half: animate current progress to 0
        return currentProgress * (1 - restartProgress * 2);
      } else {
        // Second half: animate from 0 to full
        return (restartProgress - 0.5) * 2;
      }
    }
    
    // Normal progress calculation
    return Math.max(0, effect.duration / (effect.maxDuration || 1));
  }


