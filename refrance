          Math.abs(prevStates.magnetProgress - newPowerUpStates.magnetProgress) > threshold ||
          prevStates.shieldActive !== newPowerUpStates.shieldActive ||
          Math.abs(prevStates.shieldProgress - newPowerUpStates.shieldProgress) > threshold ||
          prevStates.timeFreezeActive !== newPowerUpStates.timeFreezeActive ||
